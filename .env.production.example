# Dominio público ya dirigido a la IP del servidor. No incluyas protocolo ni ruta.
APP_DOMAIN=gobernanza.example.com
ACME_EMAIL=administrador@example.com

# PostgreSQL privado dentro de Docker. Usa valores aleatorios largos.
POSTGRES_DB=gobernanza
POSTGRES_USER=gobernanza
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Usa "db" como host (no 127.0.0.1) porque la API se ejecuta en otro contenedor.
DATABASE_URL=postgresql://gobernanza:replace-with-a-long-random-password@db:5432/gobernanza

# Primera cuenta de la aplicación. Cambia ambas credenciales antes de desplegar.
SEED_ADMIN_USERNAME=supervisor
SEED_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
SEED_ADMIN_NAME=Supervisor inicial

# Opcional: mantiene la integración externa de EIA. Nunca la expongas al navegador.
EIA_API_KEY=
