# Imagen de ejecución de la API, el entrenamiento XGBoost y la importación inicial.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    REPORTS_PATH=/var/lib/gobernanza/reports

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY api ./api
COPY public/imports ./public/imports

RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /var/lib/gobernanza/reports \
    && chown -R appuser:appuser /app /var/lib/gobernanza

USER appuser

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
